# ==============================================================================
# Big Data Pipeline & Phase 2 API Environment Configuration Example
# Copy this file to '.env' and adjust the configuration values as needed.
# DO NOT COMMIT SENSITIVE PASSWORDS, SECRETS, OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# MongoDB Connection Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=midterm_db

# Engine Routing Configuration
# Files with size <= threshold (in MB) use Python Batch streaming; larger files use PySpark.
SMALL_FILE_THRESHOLD_MB=200.0
BATCH_SIZE=5000

# Apache Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=MidtermDataPipeline

# FastAPI Unified Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
